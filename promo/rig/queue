#!/bin/bash
# queue <shots-file> <outdir> name[:seconds] …   — film a list of shots one after another, logging each
file=$1; out=$2; shift 2; here="$(cd "$(dirname "$0")" && pwd)"
for item in "$@"; do
  name="${item%%:*}"; secs=""; [ "$item" != "$name" ] && secs="--seconds ${item#*:}"
  "$here/film" "$file" --shot "$name" --out "$out" $secs 2>&1 | tr '\r' '\n' | grep -E "frames in|page said|console: [^F]|page:|never|no such|hand:"
done
echo "queue done: $*"
